{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$tsc",
      "label": "npm: build"
    },
    {
      "type": "npm",
      "script": "watch:extension",
      "group": "build",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "source": "ts",
        "applyTo": "closedDocuments",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^build started\\.\\.\\.$",
          "endsPattern": "^built in .*$"
        }
      },
      "label": "npm: watch:extension"
    },
    {
      "type": "npm",
      "script": "watch:webview",
      "group": "build",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "source": "ts",
        "applyTo": "closedDocuments",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^build started\\.\\.\\.$",
          "endsPattern": "^built in .*$"
        }
      },
      "label": "npm: watch:webview"
    },
    {
      "label": "watch:all",
      "dependsOn": ["npm: watch:extension", "npm: watch:webview"],
      "problemMatcher": []
    }
  ]
}
