{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Good Buddy Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/out/**/*.cjs"],
      "preLaunchTask": "npm: build",
      "timeout": 20000
    }
  ]
}
