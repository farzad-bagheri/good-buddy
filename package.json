{
  "name": "good-buddy",
  "displayName": "Good Buddy - Local AI Coding Assistant",
  "description": "A local-first VS Code coding assistant powered by Ollama or OpenAI-compatible model servers.",
  "keywords": [
    "local ai",
    "local llm",
    "ollama",
    "openai-compatible",
    "ai coding assistant",
    "code assistant",
    "code completion",
    "inline completions",
    "copilot alternative",
    "private ai"
  ],
  "version": "0.0.7",
  "publisher": "dabanli",
  "license": "MIT",
  "type": "module",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/farzad-bagheri/good-buddy"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.cjs",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "goodBuddy",
          "title": "Good Buddy",
          "icon": "media/app.svg"
        }
      ]
    },
    "views": {
      "goodBuddy": [
        {
          "type": "webview",
          "id": "goodBuddy.chatView",
          "name": "Chat",
          "icon": "media/app.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "goodBuddy.explainCode",
        "title": "Good Buddy: Explain Selected Code"
      },
      {
        "command": "goodBuddy.toggleInlineCompletions",
        "title": "Good Buddy: Toggle Inline Completions"
      },
      {
        "command": "goodBuddy.showOutput",
        "title": "Good Buddy: Show Output Log"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "goodBuddy.explainCode",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Good Buddy",
      "properties": {
        "goodBuddy.provider": {
          "type": "string",
          "enum": [
            "ollama",
            "openai-compatible"
          ],
          "default": "openai-compatible",
          "description": "The provider for the Good Buddy assistant."
        },
        "goodBuddy.endpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Base URL of the local Ollama server, used when goodBuddy.provider is 'ollama'."
        },
        "goodBuddy.openAICompatibleEndpoint": {
          "type": "string",
          "default": "http://localhost:1234/v1",
          "description": "Base URL of an OpenAI-compatible API, including its API prefix (for example, LM Studio's http://localhost:1234/v1)."
        },
        "goodBuddy.openAICompatibleApiKey": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional API key sent as a Bearer token to the OpenAI-compatible API."
        },
        "goodBuddy.completionModel": {
          "type": "string",
          "default": "",
          "description": "Legacy Ollama model ID used only when no saved completion model is available. Prefer selecting a model in the chat view."
        },
        "goodBuddy.chatModel": {
          "type": "string",
          "default": "",
          "description": "Legacy Ollama model ID used only when no saved chat model is available. Prefer selecting a model in the chat view."
        },
        "goodBuddy.inlineCompletionsEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline (ghost text) completions from the local model."
        },
        "goodBuddy.maxContextLines": {
          "type": "number",
          "default": 100,
          "description": "Max number of lines of surrounding code to send as context for completions."
        },
        "goodBuddy.completionTimeoutMs": {
          "type": "number",
          "default": 30000,
          "description": "How long to wait for an inline completion before giving up, in milliseconds. Increase for large models or slower hardware."
        }
      }
    }
  },
  "scripts": {
    "prepare": "husky",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies",
    "build": "pnpm run compile:shell && pnpm run build:extension && pnpm run build:webview",
    "build:extension": "vite build",
    "build:webview": "pnpm --filter @good-buddy/chat-webview run build",
    "compile:shell": "node scripts/html/compile-shell.js",
    "check": "pnpm run check:extension && pnpm run check:webview",
    "check:extension": "tsc --noEmit -p ./",
    "check:webview": "pnpm --filter @good-buddy/chat-webview run check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "watch:extension": "vite build --watch",
    "watch:webview": "pnpm --filter @good-buddy/chat-webview run watch",
    "clean": "rm -rf out"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vitest/coverage-v8": "^5.0.1",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "marked": "^18.0.14"
  },
  "packageManager": "pnpm@11.21.0"
}
